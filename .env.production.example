# Production PostgreSQL Configuration (use with prisma/schema.postgres.prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/gamma_prod?schema=public"
NEXTAUTH_URL="https://gamma.yourdomain.com"
NEXTAUTH_SECRET="replace-with-production-nextauth-secret"
ACCOUNT_ADMISSION_MODE="invitation-only"
BOOTSTRAP_ADMIN_EMAIL="admin@yourdomain.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-admin-password"
